# First-party workbench (bound to loopback by default).
DCAL_WORKBENCH_BIND_IP=127.0.0.1
DCAL_WORKBENCH_PORT=8090
# Generate once with: openssl rand -hex 32
DCAL_WORKBENCH_INGEST_TOKEN=replace-with-a-random-64-character-secret

# Optional legacy Label Studio compatibility profile.
LABEL_STUDIO_IMAGE=heartexlabs/label-studio:1.23.0
LABEL_STUDIO_PORT=8080
LABEL_STUDIO_HOST=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080

LABEL_STUDIO_USERNAME=admin@dcal.local
LABEL_STUDIO_PASSWORD=replace-with-a-long-random-password

POSTGRES_DB=dcal_labelstudio
POSTGRES_USER=dcal_labelstudio
POSTGRES_PASSWORD=replace-with-a-different-long-random-password

# Only the derived, checksum-addressed page cache is mounted into this root.
LABEL_STUDIO_LOCAL_FILES_SERVING_ENABLED=true

# Used by project bootstrap and ingestion; never commit the real value.
LABEL_STUDIO_API_TOKEN=
DCAL_LABEL_STUDIO_PROJECT_ID=
DCAL_LABEL_STUDIO_INTERNAL_URL=http://label-studio:8080

# Dedicated Google Drive or Google Workspace Shared Drive root.
DCAL_DRIVE_ROOT_FOLDER_ID=
DCAL_GOOGLE_CREDENTIALS_FILE=./secrets/google-drive-credentials.json
GOOGLE_DELEGATED_SUBJECT=

# Generate once with: openssl rand -hex 32
# Changing it changes every patient, encounter, and source grouping ID.
DCAL_GROUP_HMAC_KEY=
DCAL_INGESTION_INTERVAL_SECONDS=60
