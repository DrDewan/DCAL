NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
DCAL_WORKBENCH_INGEST_TOKEN=replace-with-at-least-32-random-bytes
# Optional. Comma-separated absolute origins allowed to make mutating requests.
# When set, it is authoritative and request headers cannot widen it. Leave unset
# on preview deployments, whose URLs change per branch.
DCAL_APP_ORIGIN=https://your-production-workbench.vercel.app
